  "segments": [
    {
      "start": 0,
      "duration": 1,
      "text": "इंटरेस्टेड इन जिओपॉलिटिक्स एंड फॉरेन"
    },
    {
      "start": 1,
      "duration": 2,
      "text": "अफेयर्स। नाउ यू कैन वर्क विथ मिनिस्ट्री"
    },
    {
      "start": 3,
      "duration": 2,
      "text": "ऑफ़ एक्सटर्नल अफेयर्स जस्ट एज़ अ कंसलटेंट।"
    },
    {
      "start": 5,
      "duration": 3,
      "text": "सुषमा स्वराज इंस्टीट्यूट ऑफ़ फॉरेन सर्विस"
    },
    {
      "start": 8,
      "duration": 2,
      "text": "इज़ हायरिंग कंसलटेंट्स एंड दे विल गेट अप"
    },
    {
      "start": 10,
      "duration": 2,
      "text": "टू ₹10 लाख पर ईयर। इट्स अ वन ईयर"
    },
    {
      "start": 12,
      "duration": 3,
      "text": "कंसलटेंसी कॉन्ट्रैक्ट एट इंडियास फॉरेन"
    },
    {
      "start": 15,
      "duration": 1,
      "text": "सर्विस ट्रेनिंग इंस्टीट्यूट। द प्लेस"
    },
    {
      "start": 16,
      "duration": 3,
      "text": "वेयर आईएफएस ऑफिसर्स एंड फॉरेन"
    },
    {
      "start": 19,
      "duration": 1,
      "text": "डिप्लोमैट्स आर ट्रेंड। यू वुड वर्क एस"
    },
    {
      "start": 20,
      "duration": 2,
      "text": "कोर्स कोऑर्डिनेटर फॉर ट्रेनिंग"
    },
    {
      "start": 22,
      "duration": 2,
      "text": "प्रोग्राम्स, क्यूरेट कंटेंट लीज़ विथ"
    },
    {
      "start": 24,
      "duration": 2,
      "text": "इंटरनेशनल एंटिटीज़, कंडक्ट रिसर्च ऑन"
    },
    {
      "start": 26,
      "duration": 3,
      "text": "फॉरेन पॉलिसी एंड इवैलुएट ट्रेनीज़। द"
    },
    {
      "start": 29,
      "duration": 2,
      "text": "एलिजिबिलिटी मास्टर्स डिग्री और हायर"
    },
    {
      "start": 31,
      "duration": 2,
      "text": "प्रेफरेबली इन इंटरनेशनल रिलेशंस,"
    },
    {
      "start": 33,
      "duration": 2,
      "text": "पॉलिटिकल साइंस और इकोनॉमिक्स,"
    },
    {
      "start": 35,
      "duration": 3,
      "text": "एक्सपीरियंस इन एकेडेमिया, थिंक टैंक्स और"
    },
    {
      "start": 38,
      "duration": 2,
      "text": "रिसर्च ऑर्गेनाइजेशन इन फॉरेन पॉलिसी और"
    },
    {
      "start": 40,
      "duration": 3,
      "text": "इंटरनेशनल अफेयर्स मस्ट बी अंडर 35 इयर्स"
    },
    {
      "start": 43,
      "duration": 2,
      "text": "ऑफ़ एज। डिजायरेबल क्राइटेरिया इंक्लूड"
    },
    {
      "start": 45,
      "duration": 2,
      "text": "पब्लिश्ड वर्क, एविडेंस ऑफ़ ओरिजिनल"
    },
    {
      "start": 47,
      "duration": 3,
      "text": "थिंकिंग एंड डोमेन नॉलेज इन फॉरेन पॉलिसी"
    },
    {
      "start": 50,
      "duration": 2,
      "text": "और पब्लिक पॉलिसी। एप्लीकेशंस क्लोज ऑन"
    },
    {
      "start": 52,
      "duration": 3,
      "text": "फेब्रुवर 18थ 2026। अप्लाई विर ईमेल ओर"
    },
    {
      "start": 55,
      "duration": 3,
      "text": "रजिस्टर्ड पोस्ट। द लिंक इज इन द पिन,"
    },
    {
      "start": 58,
      "duration": 3.0,
      "text": "कमेंट बिलो।"
    }
  ]
